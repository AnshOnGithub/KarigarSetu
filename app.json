{
  "expo": {
    "name": "KarigarSetu",
    "slug": "karigarsetu",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/app/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#1F6B47"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.karigarsetu.app"
    },
    "android": {
      "package": "com.karigarsetu.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/app/adaptive-icon.png",
        "backgroundColor": "#FAF7E3"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/images/app/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "backgroundColor": "#1F6B47"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "KarigarSetu uses your photos to create product listings.",
          "cameraPermission": "KarigarSetu uses your camera to photograph your products."
        }
      ],
      "expo-font",
      [
        "expo-audio",
        {
          "microphonePermission": "KarigarSetu uses your microphone so you can describe your products by voice."
        }
      ],
      "expo-asset"
    ],
    "androidStatusBar": {
      "backgroundColor": "#1F6B47",
      "barStyle": "light-content",
      "translucent": false
    }
  }
}
