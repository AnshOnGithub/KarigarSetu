{
  "name": "karigarsetu-api",
  "version": "1.0.0",
  "private": true,
  "description": "KarigarSetu Market Linkage API — pushes artisan catalogues to ONDC, GeM and government e-marketplaces.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --experimental-sqlite --no-warnings=ExperimentalWarning --env-file-if-exists=.env src/index.ts",
    "start": "tsx --experimental-sqlite --no-warnings=ExperimentalWarning --env-file-if-exists=.env src/index.ts",
    "typecheck": "tsc --noEmit",
    "seed:partner": "tsx --experimental-sqlite --no-warnings=ExperimentalWarning --env-file-if-exists=.env src/scripts/createPartner.ts"
  },
  "engines": {
    "node": ">=22.5"
  },
  "dependencies": {
    "express": "^5.2.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.3",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
